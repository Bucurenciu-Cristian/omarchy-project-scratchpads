#!/bin/bash

# Switch the current project by its position in projects.conf.
# Usage: omarchy-project-select <index>

source "$(dirname -- "$(readlink -f -- "$0")")/lib.sh"

line=$(project_line_by_index "${1:-}")
if [[ -z $line ]]; then
  notify "Project" "No project at position ${1:-?}"
  exit 1
fi

project=$(field "$line" 1)
set_current_project "$project"
log_action switch "$project" direct
notify "Project" "Switched to: $project"
