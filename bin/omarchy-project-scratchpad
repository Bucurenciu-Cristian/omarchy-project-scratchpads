#!/bin/bash

# Project scratchpads: one Hyprland special workspace per project.
# Usage: omarchy-project-scratchpad [toggle|send|send-to <index>|set <index>|current|
#                                    session [name]|dir [name]|dirs [name]|show|list]

source "$(dirname -- "$(readlink -f -- "$0")")/lib.sh"

require_project() {
  local project
  project=$(current_project)
  if [[ -z $project ]]; then
    notify "Project scratchpad" "No project configured. Open the picker with Super+Shift+P."
    exit 1
  fi
  echo "$project"
}

require_index() {
  local line
  line=$(project_line_by_index "$1")
  if [[ -z $line ]]; then
    notify "Project scratchpad" "No project at position $1"
    exit 1
  fi
  field "$line" 1
}

# Hyprland's Lua config takes dispatchers as Lua expressions
dispatch() {
  if ! hyprctl dispatch "$1" >/dev/null; then
    notify "Project scratchpad" "Hyprland rejected: $1"
    exit 1
  fi
}

toggle_special() { dispatch "hl.dsp.workspace.toggle_special(\"project:$1\")"; }
move_to_special() { dispatch "hl.dsp.window.move({ workspace = \"special:project:$1\", follow = false })"; }

case "${1:-toggle}" in
  toggle)
    project=$(require_project) || exit 1
    toggle_special "$project"
    ;;
  send)
    project=$(require_project) || exit 1
    move_to_special "$project"
    ;;
  send-to)
    project=$(require_index "${2:-1}") || exit 1
    move_to_special "$project"
    ;;
  set)
    project=$(require_index "${2:-1}") || exit 1
    set_current_project "$project"
    notify "Project" "Switched to: $project"
    ;;
  current) current_project ;;
  session | tmux-session) project_session "${2:-$(current_project)}" ;;
  dir) project_dir "${2:-$(current_project)}" ;;
  dirs) field "$(project_line_by_name "${2:-$(current_project)}")" 3 ;;
  show) notify "Current project" "$(current_project)" ;;
  list) project_lines | cut -d'|' -f1 ;;
  *)
    echo "Usage: omarchy-project-scratchpad [toggle|send|send-to <index>|set <index>|current|session [name]|dir [name]|dirs [name]|show|list]" >&2
    exit 1
    ;;
esac
