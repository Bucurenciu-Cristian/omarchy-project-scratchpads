#!/bin/bash

# Project picker: switch, create, shelve and delete projects from the Omarchy menu.
# Usage: omarchy-project-picker [focus-toggle]

source "$(dirname -- "$(readlink -f -- "$0")")/lib.sh"

MENU_SELECT="${PROJECTS_MENU_SELECT:-omarchy-menu-select}"
MENU_INPUT="${PROJECTS_MENU_INPUT:-omarchy-menu-input}"
TAB=$'\t'

ACTION_TERMINAL="Open project terminal"
ACTION_SHELVED="Shelved projects…"
ACTION_FOCUS_ON="Focus mode: on"
ACTION_FOCUS_OFF="Focus mode: off"
ACTION_NEW="New project"
ACTION_TOGGLE="Shelve or activate a project"
ACTION_DELETE="Delete project"
ACTION_EDIT="Edit projects.conf"

DIR_CUSTOM="Enter a custom path"
DIR_NONE="No folder yet"

select_one() { # prompt option...  -> selected label (subtext stripped)
  local prompt="$1" selection
  shift
  selection=$("$MENU_SELECT" "$prompt" "$@" -- --width 520) || return 1
  echo "${selection%%"$TAB"*}"
}

ask() { "$MENU_INPUT" "$1" --width 520; }

# One menu row per project: "<glyph>\t<name>\t<position · windows · server>"
project_rows() { # all|active|pending
  local want="$1" idx=0 line name status subtext count clients servers
  clients=$(clients_json)
  servers=$(projects_with_servers)
  while IFS= read -r line; do
    ((idx++))
    name=$(field "$line" 1)
    status=$(project_status "$line")
    [[ $want != all && $status != "$want" ]] && continue
    (( idx <= 9 )) && subtext="Ctrl+Alt+$idx" || subtext="#$idx"
    count=$(window_count "$name" "$clients")
    (( count == 1 )) && subtext+=" · 1 window"
    (( count > 1 )) && subtext+=" · $count windows"
    grep -qx -- "$name" <<<"$servers" && subtext+=" · ▶ dev server"
    [[ $status == active ]] && glyph="●" || glyph="○"
    printf '%s\t%s\t%s\n' "$glyph" "$name" "$subtext"
  done < <(project_lines)
}

switch_to() { # name
  local idx
  idx=$(project_index "$1")
  [[ -n $idx ]] && "$BIN_DIR/omarchy-project-select" "$idx"
}

# Friction before leaving the current focus: say why, and respect the daily budget
confirm_switch() { # name -> 0 when the switch should go ahead
  local name="$1" reason count budget answer
  reason=$(ask "Why switch to $name?") || true
  if [[ -z $reason ]]; then
    log_action unshelve-cancel "$name" "cancelled at why prompt"
    return 1
  fi

  count=$(today_switch_count)
  budget=$(switch_budget)
  if (( count >= budget )); then
    log_action budget-hit "$name" "count=$count budget=$budget"
    answer=$(select_one "$count switches today, over the budget of $budget" "Switch anyway" "Stay focused") || true
    if [[ $answer != "Switch anyway" ]]; then
      log_action unshelve-cancel "$name" "stopped by budget gate"
      return 1
    fi
    log_action budget-override "$name" "count=$count"
  fi

  log_action switch "$name" "unshelve: $reason"
}

set_status() { # name status
  local line
  line=$(project_line_by_name "$1")
  [[ -n $line ]] || return 1
  replace_project_line "$1" "$(field "$line" 1)|$(field "$line" 2)|$(field "$line" 3)|$2"
}

shelved_projects() {
  local rows name
  mapfile -t rows < <(project_rows pending)
  if (( ${#rows[@]} == 0 )); then
    notify "Projects" "No shelved projects"
    return 0
  fi

  name=$(select_one "Shelved projects" "${rows[@]}") || return 0
  confirm_switch "$name" || return 0
  set_status "$name" active
  log_action activate "$name" "via unshelve"
  local idx
  idx=$(project_index "$name")
  set_current_project "$name"
  notify "Projects" "Activated and switched to: $name (Ctrl+Alt+$idx)"
}

browse_directory() {
  local -a roots=() dirs=()
  local root
  # shellcheck disable=SC2088 # "~" is expanded per entry below
  IFS=',' read -ra roots <<<"$(setting search_paths "~/Projects,~/projects,~/Work,~/dev,~/code")"
  for root in "${roots[@]}"; do
    root="${root/#\~/$HOME}"
    [[ -d $root ]] || continue
    if command -v fd >/dev/null; then
      mapfile -t -O "${#dirs[@]}" dirs < <(fd --type d --max-depth "$(setting search_depth 2)" \
        --exclude node_modules --exclude .cache --exclude __pycache__ --exclude venv --exclude .venv \
        . "$root" 2>/dev/null)
    else
      mapfile -t -O "${#dirs[@]}" dirs < <(find "$root" -mindepth 1 -maxdepth "$(setting search_depth 2)" -type d \
        ! -path '*/.*' ! -path '*/node_modules*' ! -path '*/__pycache__*' ! -path '*/venv*' 2>/dev/null)
    fi
  done

  local -a options=("󰏫${TAB}$DIR_CUSTOM" "󰜄${TAB}$DIR_NONE")
  local dir
  while IFS= read -r dir; do
    dir="${dir%/}"
    options+=("󰉋${TAB}${dir/#$HOME/\~}")
  done < <(printf '%s\n' "${dirs[@]}" | grep -v '^$' | sort -u)

  select_one "Project folder" "${options[@]}"
}

create_project() {
  local selection dir suggested name answer
  selection=$(browse_directory) || return 0

  case "$selection" in
    "$DIR_CUSTOM")
      dir=$(ask "Project folder path") || return 0
      ;;
    "$DIR_NONE")
      dir=""
      ;;
    *)
      dir="$selection"
      ;;
  esac
  dir="${dir/#\~/$HOME}"

  if [[ -n $dir ]]; then
    suggested=$(basename -- "$dir" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9_-')
    answer=$(select_one "Project name" "$suggested" "Type a different name…") || return 0
    [[ $answer == "$suggested" ]] && name="$suggested" || name=$(ask "Project name") || return 0
  else
    name=$(ask "Project name") || return 0
  fi

  if [[ ! $name =~ ^[a-zA-Z0-9_-]+$ ]]; then
    notify "Projects" "Invalid name \"$name\". Use only letters, numbers, - and _."
    return 1
  fi
  if [[ -n $(project_line_by_name "$name") ]]; then
    notify "Projects" "A project named $name already exists"
    return 1
  fi

  [[ -f $CONFIG_FILE ]] || install -D /dev/null "$CONFIG_FILE"
  append_project_line "$name|$name|${dir/#$HOME/\~}|active"
  log_action create "$name" "dir=${dir:-none}"
  notify "Projects" "Created $name"
  switch_to "$name"
}

toggle_status() {
  local rows name line
  mapfile -t rows < <(project_rows all)
  (( ${#rows[@]} )) || { notify "Projects" "No projects yet"; return 0; }
  name=$(select_one "Shelve or activate" "${rows[@]}") || return 0
  line=$(project_line_by_name "$name")
  if [[ $(project_status "$line") == active ]]; then
    set_status "$name" pending
    log_action shelve "$name" "via toggle"
    notify "Projects" "Shelved $name"
  else
    set_status "$name" active
    log_action activate "$name" "via toggle"
    notify "Projects" "Activated $name"
  fi
}

delete_project() {
  local rows name confirm
  mapfile -t rows < <(project_rows all)
  (( ${#rows[@]} )) || { notify "Projects" "No projects yet"; return 0; }
  name=$(select_one "Delete which project?" "${rows[@]}") || return 0
  confirm=$(select_one "Delete $name? Its windows and folder are not touched." "Keep $name" "Delete $name") || return 0
  [[ $confirm == "Delete $name" ]] || return 0
  replace_project_line "$name"
  log_action delete "$name"
  notify "Projects" "Deleted $name"
}

focus_toggle() {
  if focus_mode; then
    echo 0 >"$FOCUS_FILE"
    log_action focus-off
    notify "Projects" "Focus mode off"
  else
    echo 1 >"$FOCUS_FILE"
    log_action focus-on
    notify "Projects" "󰈈 Focus mode on: shelved projects are hidden"
  fi
}

main() {
  local -a options
  mapfile -t options < <(project_rows active)
  options+=("󰆍${TAB}$ACTION_TERMINAL")
  if focus_mode; then
    options+=("󰈈${TAB}$ACTION_FOCUS_ON")
  else
    options+=("󰏗${TAB}$ACTION_SHELVED" "󰈉${TAB}$ACTION_FOCUS_OFF")
  fi
  options+=("󰐕${TAB}$ACTION_NEW" "󰔡${TAB}$ACTION_TOGGLE" "󰆴${TAB}$ACTION_DELETE" "󰏫${TAB}$ACTION_EDIT")

  local selected
  selected=$(select_one "Projects" "${options[@]}") || exit 0

  case "$selected" in
    "$ACTION_TERMINAL") exec "$BIN_DIR/omarchy-project-terminal" ;;
    "$ACTION_SHELVED") shelved_projects ;;
    "$ACTION_FOCUS_ON" | "$ACTION_FOCUS_OFF") focus_toggle ;;
    "$ACTION_NEW") create_project ;;
    "$ACTION_TOGGLE") toggle_status ;;
    "$ACTION_DELETE") delete_project ;;
    "$ACTION_EDIT") exec omarchy-launch-editor "$CONFIG_FILE" ;;
    *) switch_to "$selected" ;;
  esac
}

case "${1:-}" in
  focus-toggle) focus_toggle ;;
  *) main ;;
esac
