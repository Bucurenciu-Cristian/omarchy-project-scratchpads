# Project Scratchpads
# One project per line: name|session|directory|status
#   name       letters, numbers, - and _ (its scratchpad is special:project:<name>)
#   session    herdr session opened by the project terminal
#   directory  project folder; several may be listed, comma-separated, the first is used
#   status     active (shown in the picker) or pending (shelved)
# The order sets Ctrl+Alt+1-9.
#
# Example:
#   myapp|myapp|~/Work/myapp|active
#   sideproject|sideproject|~/Work/sideproject|pending

# [settings]
# focus_mode=false
# daily_switch_budget=3
# search_paths=~/Projects,~/projects,~/Work,~/dev,~/code
# search_depth=2
