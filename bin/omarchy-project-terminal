#!/bin/bash

# Open a terminal on the current project's herdr session, started in the
# project directory. herdr creates the session the first time and reattaches
# after that, so the project's panes and agents persist between windows.
# Usage: omarchy-project-terminal [project]

source "$(dirname -- "$(readlink -f -- "$0")")/lib.sh"

project="${1:-$(current_project)}"
if [[ -z $project ]]; then
  notify "Project terminal" "No project configured. Open the picker with Super+Shift+P."
  exit 1
fi

exec setsid uwsm-app -- xdg-terminal-exec --dir="$(project_dir "$project")" herdr --session "$(project_session "$project")"
